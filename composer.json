{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "afurgeri/laravel-ai",
    "description": "Modular AI assistants, tools and execution tracking for Laravel with SQL and MongoDB storage.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/ai": "^1.3"
    },
    "require-dev": {
        "mongodb/laravel-mongodb": "^5.11",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "suggest": {
        "mongodb/laravel-mongodb": "Required for MongoDB storage (^5.11), together with ext-mongodb."
    },
    "autoload": {
        "psr-4": { "Modules\\Ai\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "AiTests\\": "tests/" }
    },
    "extra": {
        "laravel": { "providers": ["Modules\\Ai\\AiServiceProvider"] }
    },
    "scripts": { "test": "pest --compact" },
    "config": { "allow-plugins": { "pestphp/pest-plugin": true } }
}
